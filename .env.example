# Copy to .env for running the app/tests on the host (not needed for docker compose,
# which injects config via the compose `environment:` block).

APP_ENV=development
LOG_LEVEL=info

# Host-side hosts use the published compose ports (5435 / 6380).
DATABASE_URL=postgresql://lumina:lumina@localhost:5435/lumina
REDIS_URL=redis://localhost:6380/0
CACHE_TTL_SECONDS=3600

# Embeddings / LLM — needed from Step 2 onward.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
